// DataOcean Instance Manager - Database Schema
// DBML (Database Markup Language) for visual modeling and refinement
// Generated from: docs/master/05-data-model.md
// Architecture: ArgoCD App of Apps pattern with Template Versioning

Project DataOcean_Instance_Manager {
  database_type: 'PostgreSQL'
  Note: '''
  # DataOcean Instance Manager Database Schema
  
  Core Features:
  - Multi-region ArgoCD App of Apps deployments
  - Template versioning with Blueprint governance
  - Commit-based instance isolation
  - 3-level values inheritance hierarchy
  
  Key Design Patterns:
  - Template + Template_Version separation for versioning
  - Blueprint + Blueprint_Version for governance
  - Instance inherits template versions via Blueprint_Version
  - BIGSERIAL PKs for performance (internal IDs)
  - UUID columns when external exposure needed (security)
  '''
}

// ================================================================
// INFRASTRUCTURE ENTITIES
// ================================================================

Table locations {
  id bigserial [pk]
  name varchar(100) [not null, unique]
  description text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  Note: 'Geographical regions for deployments (Brazil, EMEA, USA)'
  
  indexes {
    name [unique, name: "idx_locations_name"]
  }
}

Table environments {
  id bigserial [pk]
  name varchar(100) [not null, unique]
  description text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  Note: 'Deployment environments (Development, Staging, Production)'
  
  indexes {
    name [unique, name: "idx_environments_name"]
  }
}

Table clusters {
  id bigserial [pk]
  name varchar(100) [not null, unique]
  description text
  server_url varchar(500) [not null, unique]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  Note: '''
  Kubernetes clusters available for deployment.
  User selects specific cluster during instance creation.
  '''
  
  indexes {
    name [unique, name: "idx_clusters_name"]
    server_url [unique, name: "idx_clusters_server_url"]
  }
}

// ================================================================
// APPLICATION ENTITIES
// ================================================================

Table applications {
  id bigserial [pk]
  name varchar(100) [not null, unique]
  description text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  Note: 'Business applications that can be deployed'
  
  indexes {
    name [unique, name: "idx_applications_name"]
  }
}

// ================================================================
// TEMPLATE VERSIONING ENTITIES
// ================================================================

Table repositories {
  id bigserial [pk]
  description text
  azure_devops_org varchar(100) [not null]
  azure_devops_project varchar(100) [not null]
  repository_name varchar(100) [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  Note: '''
  Azure DevOps repositories that contain Helm Charts.
  Uses Azure Managed Identity for authentication.
  git_url constructed as: https://dev.azure.com/{azure_devops_org}/{azure_devops_project}/_git/{repository_name}
  repository_name serves as the natural identifier.
  '''
  
  indexes {
    (azure_devops_org, azure_devops_project, repository_name) [unique, name: "idx_repositories_devops_repo"]
    repository_name [name: "idx_repositories_name"]
  }
}

Table branches {
  id bigserial [pk]
  repository_id bigint [not null]
  name varchar(100) [not null]
  deleted boolean [default: false]
  deleted_at timestamp
  recovered_at timestamp
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  Note: '''
  Branches within repositories that are being tracked/considered by the system.
  User explicitly adds branches they want to monitor.
  
  SYNC Functionality Support:
  - deleted=true when branch no longer exists in Git remote
  - recovered_at tracks when deleted branch is restored
  - Supports automatic branch recovery detection
  - Template versions from deleted branches are auto-disabled
  '''
  
  indexes {
    (repository_id, name) [unique, name: "idx_branches_repo_name"]
    repository_id [name: "idx_branches_repository"]
  }
}

Table templates {
  id bigserial [pk]
  public_id uuid [unique, not null, default: `gen_random_uuid()`]
  name varchar(100) [not null, unique]
  description text
  repository_id bigint [not null]
  git_path varchar(255) [not null]
  current_version_id bigint
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  Note: '''
  Template metadata for Helm Charts within a repository.
  Each template represents a chart path within a repository.
  Versions of this template can exist across multiple branches.
  Uses UUID for external API exposure (security).
  '''
  
  indexes {
    public_id [unique, name: "idx_templates_public_id"]
    name [unique, name: "idx_templates_name"]
    repository_id [name: "idx_templates_repository"]
    current_version_id [name: "idx_templates_current_version"]
    (repository_id, git_path) [unique, name: "idx_templates_repo_path"]
  }
}

Table template_versions {
  id bigserial [pk]
  template_id bigint [not null]
  branch_id bigint [not null]
  branch_name varchar(100) [not null]
  git_commit_hash varchar(40) [not null]
  chart_metadata jsonb [not null]
  default_values jsonb [not null]
  values_schema jsonb
  commit_message text
  commit_author varchar(255)
  disabled boolean [default: false]
  disabled_reason varchar(100)
  disabled_at timestamp
  recovered_at timestamp
  imported_at timestamp [default: `now()`]
  
  Note: '''
  Historical versions of Helm Chart data imported from specific branch.
  Each version is tied to a template and a specific branch.
  
  SYNC Functionality Support:
  - disabled=true when commits become orphaned or branch deleted
  - disabled_reason: 'orphaned_commit', 'branch_deleted', 'manual', 'security', 'deprecated'
  - disabled_at/recovered_at track automatic recovery events
  - branch_name denormalized for efficient SYNC queries
  - Supports automatic recovery when commits return to Git history
  
  Disabled versions cannot be used for new instances but preserve audit trail.
  '''
  
  indexes {
    (template_id, branch_id, git_commit_hash) [unique, name: "idx_template_versions_template_branch_commit"]
    (template_id, branch_name) [name: "idx_template_versions_template_branch_name"]
    template_id [name: "idx_template_versions_template"]
    branch_id [name: "idx_template_versions_branch"]
    git_commit_hash [name: "idx_template_versions_commit"]
    disabled [name: "idx_template_versions_disabled"]
    disabled_reason [name: "idx_template_versions_disabled_reason"]
    imported_at [name: "idx_template_versions_imported"]
  }
}

// ================================================================
// BLUEPRINT ENTITIES (GOVERNANCE)
// ================================================================

Table blueprints {
  id bigserial [pk]
  public_id uuid [unique, not null, default: `gen_random_uuid()`]
  name varchar(100) [not null]
  description text
  application_id bigint [not null]
  current_version_id bigint
  created_at timestamp [default: `now()`]
  
  Note: '''
  Blueprint metadata (immutable).
  Represents deployment model identity for an application.
  Uses UUID for external API exposure (security).
  '''
  
  indexes {
    public_id [unique, name: "idx_blueprints_public_id"]
    (application_id, name) [unique, name: "idx_blueprints_app_name"]
    application_id [name: "idx_blueprints_application"]
    current_version_id [name: "idx_blueprints_current_version"]
  }
}

Table blueprint_versions {
  id bigserial [pk]
  blueprint_id bigint [not null]
  version_number integer [not null]
  helper_templates text
  status varchar(20) [default: 'draft']
  published_at timestamp
  created_at timestamp [default: `now()`]
  
  Note: '''
  Blueprint version data with draft/published lifecycle.
  Status: 'draft' (editable) or 'published' (immutable).
  Only published versions can be used by instances.
  Version numbers increment: 1, 2, 3...
  '''
  
  indexes {
    (blueprint_id, version_number) [unique, name: "idx_blueprint_versions_blueprint_version"]
    blueprint_id [name: "idx_blueprint_versions_blueprint"]
    version_number [name: "idx_blueprint_versions_version"]
  }
}

Table blueprint_templates {
  id bigserial [pk]
  blueprint_version_id bigint [not null]
  template_version_id bigint [not null]
  order_index integer [not null]
  alias varchar(100) [not null]
  custom_values jsonb
  
  Note: '''
  Relationship between Blueprint_Version and Template_Version.
  Defines tested combinations of template versions in a blueprint.
  Blueprint governance: blueprint controls which template versions to use.
  '''
  
  indexes {
    (blueprint_version_id, template_version_id, alias) [unique, name: "idx_blueprint_templates_unique"]
    (blueprint_version_id, order_index) [unique, name: "idx_blueprint_templates_order"]
    (blueprint_version_id, alias) [unique, name: "idx_blueprint_templates_alias"]
    blueprint_version_id [name: "idx_blueprint_templates_blueprint_version"]
    template_version_id [name: "idx_blueprint_templates_template_version"]
  }
}

// ================================================================
// INSTANCE ENTITIES (DEPLOYMENTS)
// ================================================================

Table instances {
  id bigserial [pk]
  public_id uuid [unique, not null, default: `gen_random_uuid()`]
  name varchar(100) [not null, unique]
  blueprint_version_id bigint [not null]
  cluster_id bigint [not null]
  location_id bigint [not null]
  environment_id bigint [not null]
  namespace varchar(63) [not null]
  auto_sync_enabled boolean [default: true]
  auto_prune_enabled boolean [default: false]
  auto_heal_enabled boolean [default: true]
  status instance_status [default: 'pending']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  Note: '''
  Concrete deployment configuration for specific cluster target.
  Inherits template versions from Blueprint_Version via Blueprint_Templates.
  Snapshot of blueprint_version_id for stability.
  User selects cluster directly, but location_id and environment_id are required
  for Helm chart path generation and deployment context.
  Namespace follows Kubernetes naming conventions (63 chars max).
  Git repository configuration is handled at system level (centralized).
  Uses UUID for external API exposure (security).
  '''
  
  indexes {
    public_id [unique, name: "idx_instances_public_id"]
    name [unique, name: "idx_instances_name"]
    blueprint_version_id [name: "idx_instances_blueprint_version"]
    cluster_id [name: "idx_instances_cluster"]
    location_id [name: "idx_instances_location"]
    environment_id [name: "idx_instances_environment"]
    namespace [name: "idx_instances_namespace"]
    status [name: "idx_instances_status"]
    (blueprint_version_id, cluster_id) [name: "idx_instances_blueprint_cluster"]
    (location_id, environment_id) [name: "idx_instances_location_environment"]
    (cluster_id, namespace) [name: "idx_instances_cluster_namespace"]
  }
}

Table instance_templates {
  id bigserial [pk]
  instance_id bigint [not null]
  blueprint_template_id bigint [not null]
  instance_values jsonb
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  Note: '''
  Central entity: Template configuration within specific instance.
  Contains final merged values: Template_Version.default_values + 
  Blueprint_Template.custom_values + Instance overrides.
  Template version inherited from Blueprint_Template.template_version_id.
  Namespace is now centralized at instance level (instances.namespace).
  '''
  
  indexes {
    (instance_id, blueprint_template_id) [unique, name: "idx_instance_templates_unique"]
    instance_id [name: "idx_instance_templates_instance"]
    blueprint_template_id [name: "idx_instance_templates_blueprint_template"]
  }
}

// ================================================================
// RELATIONSHIPS DOCUMENTATION
// ================================================================

// Infrastructure relationships
// Note: clusters are now independent - no location/environment constraints

// Application relationships  
Ref: blueprints.application_id > applications.id [delete: restrict]

// Template versioning relationships
Ref: branches.repository_id > repositories.id [delete: restrict]
Ref: templates.repository_id > repositories.id [delete: restrict]
Ref: template_versions.template_id > templates.id [delete: restrict]
Ref: template_versions.branch_id > branches.id [delete: restrict]
Ref: templates.current_version_id > template_versions.id [delete: set null]

// Blueprint versioning relationships
Ref: blueprint_versions.blueprint_id > blueprints.id [delete: restrict]
Ref: blueprints.current_version_id > blueprint_versions.id [delete: set null]

// Blueprint-Template associations (governance)
Ref: blueprint_templates.blueprint_version_id > blueprint_versions.id [delete: restrict]
Ref: blueprint_templates.template_version_id > template_versions.id [delete: restrict]

// Instance deployment relationships
Ref: instances.blueprint_version_id > blueprint_versions.id [delete: restrict]
Ref: instances.cluster_id > clusters.id [delete: restrict]
Ref: instances.location_id > locations.id [delete: restrict]
Ref: instances.environment_id > environments.id [delete: restrict]

// Instance-Template configurations
Ref: instance_templates.instance_id > instances.id [delete: cascade]
Ref: instance_templates.blueprint_template_id > blueprint_templates.id [delete: restrict]

// ================================================================
// ENUMS AND CHECK CONSTRAINTS
// ================================================================

Enum instance_status {
  pending
  deployed 
  failed
  updating
}

// ================================================================
// SYSTEM CONFIGURATION (Application Level)
// ================================================================

/*
Centralized Helm Charts Repository Configuration:
- helm_charts_repository: Single repository for all generated Helm Charts
- helm_charts_branch: Single branch for all deployments (typically "main")
- Path Structure: {environment}/{location}/{application}/{instance}/

Example System Configuration:
{
  "helm_charts_repository": "https://dev.azure.com/company/platform/_git/helm-charts",
  "helm_charts_branch": "main",
  "path_template": "{environment_name}/{location_name}/{application_name}/{instance_name}/"
}

This approach eliminates per-instance Git configuration complexity while
providing centralized governance and consistent deployment patterns.
*/